    },
    "%.0f" : {
      "comment" : "A label displaying the maximum amount of ultraviolet radiation that can be absorbed by the human body.",
      "isCommentAutoGenerated" : true
    },
    "%.1f" : {
      "comment" : "A value displayed in the gauge view, formatted to one decimal place.",
      "isCommentAutoGenerated" : true
    },
    "%@" : {
      "comment" : "The maximum recommended dose of medication for a given skin type, presented as a bolded integer. The argument is the string \"%.0f\".",
      "isCommentAutoGenerated" : true
    },
    "%@ / %@ SED" : {
      "comment" : "A text displaying the total and maximum number of SEDs for the day, followed by a progress bar that visually represents the progress. The first argument is the total number of SEDs. The second argument is the maximum number of SEDs.",
      "isCommentAutoGenerated" : true,
